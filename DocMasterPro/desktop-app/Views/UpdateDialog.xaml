<Window x:Class="DocConverter.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DocConverter.ViewModels"
        xmlns:conv="clr-namespace:DocConverter.Converters"
        Title="DocMaster Pro Güncelleme Yöneticisi"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

  <Window.Resources>
    <conv:UpdateStateVisibilityConverter x:Key="StateVis"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="Foreground" Value="#38BDF8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="TemplateRoot">
              <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
              <Border x:Name="PART_Track" CornerRadius="5"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2563EB" Offset="0"/>
                    <GradientStop Color="#38BDF8" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Outer Dialog Card with Shadow and Border -->
  <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="16" Margin="12">
    <Border.Effect>
      <DropShadowEffect Color="#000000" Opacity="0.6" BlurRadius="24" ShadowDepth="6"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 1. Header Bar -->
      <Border Grid.Row="0" Background="#131D33" CornerRadius="15,15,0,0" Padding="16,0"
              MouseDown="Header_MouseDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- App Icon & Title -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#2563EB" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
              <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="DocMaster Pro" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <TextBlock Text=" • Güncelleme Yöneticisi" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Close Button (✕) -->
          <Button Grid.Column="2" Command="{Binding CloseCommand}"
                  Background="Transparent" Foreground="#64748B" BorderThickness="0"
                  FontSize="16" Width="32" Height="32" Cursor="Hand" ToolTip="Kapat">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="CloseBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                  <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="CloseBorder" Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </Grid>
      </Border>

      <!-- 2. Dynamic Content Area Based on State -->
      <Grid Grid.Row="1" Margin="24,20,24,16">

        <!-- ==================== DURUM 1: KONTROL EDİLİYOR ==================== -->
        <StackPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Checking}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border Background="#1E293B" CornerRadius="40" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,18">
            <TextBlock Text="🔄" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#38BDF8">
              <TextBlock.RenderTransform>
                <RotateTransform x:Name="SpinnerRotation" CenterX="17" CenterY="17"/>
              </TextBlock.RenderTransform>
              <TextBlock.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                       Storyboard.TargetProperty="Angle"
                                       From="0" To="360" Duration="0:0:1.5"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </TextBlock.Triggers>
            </TextBlock>
          </Border>
          <TextBlock Text="{Binding StageTitle}" FontSize="18" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <TextBlock Text="{Binding StageDescription}" FontSize="13" Foreground="#94A3B8"
                     HorizontalAlignment="Center" Margin="0,0,0,16"/>
          <ProgressBar IsIndeterminate="True" Width="260" Style="{StaticResource ModernProgressBarStyle}"/>
        </StackPanel>

        <!-- ==================== DURUM 2: UYGULAMA GÜNCEL ==================== -->
        <StackPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=UpToDate}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border Background="#064E3B" CornerRadius="40" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,18">
            <TextBlock Text="✓" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#34D399"/>
          </Border>
          <TextBlock Text="Uygulamanız Güncel!" FontSize="20" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding StageDescription}" FontSize="14" Foreground="#94A3B8"
                     HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,6"/>
          <Border Background="#1E293B" CornerRadius="8" Padding="12,6" HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Text="{Binding CurrentVersion, StringFormat='Mevcut Sürüm: v{0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
          </Border>
        </StackPanel>

        <!-- ==================== DURUM 3: YENİ SÜRÜM MEVCUT ==================== -->
        <Grid Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=UpdateAvailable}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Sürüm Karşılaştırma Başlığı -->
          <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <TextBlock Text="🚀 " FontSize="16"/>
                  <TextBlock Text="Yeni Sürüm Hazır!" FontSize="16" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Mevcut: " FontSize="12" Foreground="#64748B"/>
                  <TextBlock Text="{Binding CurrentVersion, StringFormat='v{0}'}" FontSize="12" Foreground="#94A3B8" Margin="0,0,12,0"/>
                  <TextBlock Text="➜  Yeni: " FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                  <TextBlock Text="{Binding LatestVersion, StringFormat='v{0}'}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                </StackPanel>
              </StackPanel>

              <Border Grid.Column="1" Background="#2563EB" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="ÖNERİLEN" FontSize="11" FontWeight="Bold" Foreground="White"/>
              </Border>
            </Grid>
          </Border>

          <!-- Sürüm Notları (Changelog) -->
          <Border Grid.Row="1" Background="#0B1120" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="Yenilikler ve Değişiklikler:" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding ReleaseNotes}" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="20"/>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- ==================== DURUM 4: İNDİRİLİYOR & YÜKLENİYOR (CANLI İLERLEME) ==================== -->
        <StackPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Downloading\,Installing}"
                    VerticalAlignment="Center" Margin="10,0">

          <!-- Aşama Başlığı -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
              <TextBlock Text="📥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding StageTitle}" FontSize="17" FontWeight="Bold" Foreground="White"/>
              <TextBlock Text="{Binding StageDescription}" FontSize="12" Foreground="#94A3B8"/>
            </StackPanel>
          </StackPanel>

          <!-- İlerleme Yüzdesi ve Detaylar -->
          <Border Background="#0B1120" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,8,0,0">
            <StackPanel>
              <!-- Yüzde ve Boyut -->
              <Grid Margin="0,0,0,8">
                <TextBlock Text="{Binding ProgressPercentage, StringFormat='%{0}'}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock Text="{Binding BytesDetailText}" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>

              <!-- Progress Bar -->
              <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Margin="0,0,0,12"/>

              <!-- Hız ve Kalan Süre -->
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⚡ Hız: " FontSize="12" Foreground="#64748B"/>
                  <TextBlock Text="{Binding SpeedText}" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock Text="⏳ Kalan: " FontSize="12" Foreground="#64748B"/>
                  <TextBlock Text="{Binding TimeRemainingText}" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ==================== DURUM 5: BAŞARIYLA TAMAMLANDI ==================== -->
        <StackPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Success}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border Background="#1E3A8A" CornerRadius="40" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,18">
            <TextBlock Text="🎉" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding StageTitle}" FontSize="20" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding StageDescription}" FontSize="14" Foreground="#94A3B8"
                     HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>

        <!-- ==================== DURUM 6: HATA DURUMU ==================== -->
        <StackPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Error}"
                    VerticalAlignment="Center" Margin="10,0">
          <Border Background="#450A0A" CornerRadius="40" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,14">
            <TextBlock Text="⚠️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding StageTitle}" FontSize="18" FontWeight="Bold" Foreground="#F87171"
                     HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <Border Background="#0B1120" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,6,0,0">
            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap"/>
            </ScrollViewer>
          </Border>
        </StackPanel>

      </Grid>

      <!-- 3. Bottom Action Buttons Bar -->
      <Border Grid.Row="2" Background="#131D33" CornerRadius="0,0,15,15" Padding="18,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Sol Link (GitHub'da Aç) -->
          <Button Grid.Column="0" Command="{Binding OpenGitHubReleasesCommand}"
                  Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,6">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="🔗 " FontSize="12"/>
                  <TextBlock Text="GitHub Sürüm Sayfası" FontSize="12" Foreground="#38BDF8" TextDecorations="Underline"/>
                </StackPanel>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <!-- Sağ Butonlar -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">

            <!-- Kapat / Tamam Butonu (UpToDate veya Success durumunda) -->
            <Button Content="Tamam" Command="{Binding CloseCommand}"
                    Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=UpToDate\,Success}"
                    Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                    Padding="22,9" BorderThickness="0" Cursor="Hand">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>

            <!-- Güncelleme Butonları (UpdateAvailable durumunda) -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=UpdateAvailable}">
              <Button Content="Daha Sonra" Command="{Binding CloseCommand}"
                      Background="#1E293B" Foreground="#94A3B8" FontWeight="SemiBold"
                      Padding="16,9" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>

              <Button Content="🚀 Şimdi Güncelle" Command="{Binding StartUpdateCommand}"
                      Background="#2563EB" Foreground="White" FontWeight="Bold"
                      Padding="20,9" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </StackPanel>

            <!-- İptal Butonu (İndirme/Kontrol durumunda) -->
            <Button Content="İptal Et" Command="{Binding CancelCommand}"
                    Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Downloading\,Checking}"
                    Background="#334155" Foreground="#CBD5E1" FontWeight="SemiBold"
                    Padding="18,9" BorderThickness="0" Cursor="Hand">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>

            <!-- Yeniden Dene Butonları (Hata durumunda) -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Error}">
              <Button Content="Kapat" Command="{Binding CloseCommand}"
                      Background="#1E293B" Foreground="#94A3B8" FontWeight="SemiBold"
                      Padding="16,9" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>

              <Button Content="🔄 Yeniden Dene" Command="{Binding CheckUpdatesCommand}"
                      Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                      Padding="18,9" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </StackPanel>

          </StackPanel>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>
