<UserControl x:Class="DocConverter.Views.DeviceHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:DocConverter.Models"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="PrimaryActionBtn" TargetType="Button">
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryActionBtn" TargetType="Button">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="Foreground" Value="#1E293B"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SuccessActionBtn" TargetType="Button" BasedOn="{StaticResource PrimaryActionBtn}">
      <Setter Property="Background" Value="#16A34A"/>
    </Style>
  </UserControl.Resources>

  <Grid Background="#F8FAFC">
    <TabControl SelectedIndex="{Binding SelectedHubTabIndex}"
                Margin="16,12"
                Background="Transparent"
                BorderThickness="0">

      <!-- ==================== SEKME 1: CİHAZLAR VE SÜRÜCÜ YÖNETİMİ ==================== -->
      <TabItem Header="🔍 Cihazlar &amp; Sürücü Yönetimi" FontSize="14" FontWeight="SemiBold">
        <Grid Margin="12,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Üst Eylem Çubuğu -->
          <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Bağlı ve Ağdaki Cihazlar" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⚡ Cihazları Otomatik Tara"
                        Style="{StaticResource PrimaryActionBtn}"
                        Command="{Binding DiscoverDevicesCommand}"
                        CommandParameter="{x:Null}"
                        Margin="0,0,8,0"/>
                <Button Content="🌐 Tam Ağ Taraması (IP/Subnet)"
                        Style="{StaticResource SecondaryActionBtn}"
                        Command="{Binding DiscoverDevicesCommand}"
                        CommandParameter="{x:Null}"
                        Margin="0,0,8,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Cihazlar Listesi & Manuel Ekleme Bölümü -->
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Cihaz Listesi Kartları -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="0,0,16,0" Padding="12">
              <ListBox ItemsSource="{Binding Devices}"
                       SelectedItem="{Binding SelectedDevice}"
                       BorderThickness="0"
                       Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4"/>
                    <Setter Property="Margin" Value="0,4"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="ItemBorder"
                                  Background="White"
                                  BorderBrush="#E2E8F0"
                                  BorderThickness="1"
                                  CornerRadius="10"
                                  Padding="14">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2563EB"/>
                              <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type models:DeviceInfo}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <!-- İkon -->
                      <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="10" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TypeIcon}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>

                      <!-- Bilgiler -->
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                          <!-- Özel Model Rozeti -->
                          <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                  Visibility="{Binding IsRicohSpecial, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="RICOH SP 4510SF" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                          </Border>
                          <Border Background="#EDE9FE" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                  Visibility="{Binding IsFujitsuSpecial, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="FUJITSU FI-6230" FontSize="10" FontWeight="Bold" Foreground="#6D28D9"/>
                          </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                          <TextBlock Text="{Binding ConnectionDescription}" FontSize="12" Foreground="#64748B" Margin="0,0,12,0"/>
                          <TextBlock Text="{Binding ModelName}" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                      </StackPanel>

                      <!-- Durum ve Eylem Butonları -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{Binding DriverStatusBadgeColor}" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                          <TextBlock Text="{Binding DriverStatusDescription}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Border>

                        <Button Content="⚙️ Sürücüyü Kur / Hazırla"
                                Style="{StaticResource PrimaryActionBtn}"
                                Command="{Binding DataContext.AutoSetupDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Padding="10,6" FontSize="12"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>

            <!-- Sağ: Manuel Cihaz / IP Ekleme Paneli -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
              <StackPanel>
                <TextBlock Text="Ağ Cihazı Ekle (IP)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                <TextBlock Text="Ağdaki Ricoh veya ağ yazıcısını doğrudan IP adresi girerek bağlayabilirsiniz."
                           FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <TextBlock Text="Cihaz Adı / Modeli:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ManualDeviceName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,12"/>

                <TextBlock Text="IP Adresi:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ManualIpAddress, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,12"/>

                <TextBlock Text="Port (Varsayılan 9100 RAW):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ManualPort, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,16"/>

                <Button Content="➕ Ağ Cihazını Bağla &amp; Kaydet"
                        Style="{StaticResource SuccessActionBtn}"
                        Command="{Binding AddManualNetworkDeviceCommand}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                <Separator Margin="0,12"/>

                <TextBlock Text="Hızlı İpuçları" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                <TextBlock Text="• Ricoh SP 4510SF için 9100 numaralı port doğrudan yüksek hızlı yazdırma sağlar."
                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Text="• Fujitsu fi-6230 USB takıldığında otomatik tanınır ve ADF stüdyosuna bağlanır."
                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- İlerleme Çubuğu -->
          <ProgressBar Grid.Row="2" IsIndeterminate="{Binding IsBusy}" Height="4" Margin="0,12,0,0"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </Grid>
      </TabItem>

      <!-- ==================== SEKME 2: TARAYICI STÜDYOSU ==================== -->
      <TabItem Header="📑 Tarayıcı Stüdyosu (Fujitsu &amp; WIA)" FontSize="14" FontWeight="SemiBold">
        <Grid Margin="12,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Sol Taraf: Tarama Ayarları -->
          <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Tarama Ayarları" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                <!-- Tarayıcı Seçimi -->
                <TextBlock Text="Tarayıcı Cihazı:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedScanner}"
                          DisplayMemberPath="Name"
                          Padding="8,6" Margin="0,0,0,14"/>

                <!-- Kaynak (ADF / Flatbed) -->
                <TextBlock Text="Belge Kaynağı:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox SelectedValue="{Binding ScanOptions.Source}"
                          SelectedValuePath="Tag"
                          Padding="8,6" Margin="0,0,0,14">
                  <ComboBoxItem Content="📄 ADF - Otomatik Besleyici (Tek Yüz)" Tag="{x:Static models:ScanSource.FeederSingle}" IsSelected="True"/>
                  <ComboBoxItem Content="📑 ADF - Otomatik Besleyici (Çift Yüz / Duplex)" Tag="{x:Static models:ScanSource.FeederDuplex}"/>
                  <ComboBoxItem Content="🔲 Cam / Düz Yatak (Flatbed)" Tag="{x:Static models:ScanSource.Flatbed}"/>
                </ComboBox>

                <!-- Çözünürlük (DPI) -->
                <TextBlock Text="Çözünürlük (DPI):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox SelectedValue="{Binding ScanOptions.Resolution}"
                          SelectedValuePath="Tag"
                          Padding="8,6" Margin="0,0,0,14">
                  <ComboBoxItem Content="150 DPI (Hızlı / Düşük Dosya Boyutu)" Tag="{x:Static models:ScanResolution.Dpi150}"/>
                  <ComboBoxItem Content="200 DPI (Standart Ofis Belgesi)" Tag="{x:Static models:ScanResolution.Dpi200}"/>
                  <ComboBoxItem Content="300 DPI (Önerilen / Yüksek Kalite)" Tag="{x:Static models:ScanResolution.Dpi300}" IsSelected="True"/>
                  <ComboBoxItem Content="600 DPI (Arşiv &amp; Fotoğraf Netliği)" Tag="{x:Static models:ScanResolution.Dpi600}"/>
                </ComboBox>

                <!-- Renk Modu -->
                <TextBlock Text="Renk Modu:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox SelectedValue="{Binding ScanOptions.ColorMode}"
                          SelectedValuePath="Tag"
                          Padding="8,6" Margin="0,0,0,14">
                  <ComboBoxItem Content="🌈 24-bit Tam Renkli" Tag="{x:Static models:ScanColorMode.Color}" IsSelected="True"/>
                  <ComboBoxItem Content="🌫️ 8-bit Gri Tonlama" Tag="{x:Static models:ScanColorMode.Grayscale}"/>
                  <ComboBoxItem Content="⬛ 1-bit Siyah-Beyaz Metin" Tag="{x:Static models:ScanColorMode.BlackAndWhite}"/>
                </ComboBox>

                <!-- Otomatik Düzeltmeler -->
                <CheckBox Content="Otomatik eğrilik düzeltme (Deskew)"
                          IsChecked="{Binding ScanOptions.AutoDeskew}"
                          Margin="0,0,0,8"/>
                <CheckBox Content="Kenar boşluklarını kırp (Auto-Crop)"
                          IsChecked="{Binding ScanOptions.AutoCrop}"
                          Margin="0,0,0,16"/>

                <!-- Tarama Başlat Butonu -->
                <Button Content="▶ Belgeleri Tara"
                        Style="{StaticResource SuccessActionBtn}"
                        Command="{Binding StartScanCommand}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,8" Height="42" FontSize="14"/>

                <Button Content="🗑️ Sayfaları Temizle"
                        Style="{StaticResource SecondaryActionBtn}"
                        Command="{Binding ClearScannedPagesCommand}"
                        HorizontalAlignment="Stretch"/>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- Sağ Taraf: Taranan Sayfalar ve Canlı Önizleme -->
          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Üst Başlık & Aktarım Butonları -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Taranan Belgeler Havuzu" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                  <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="💾 PDF Olarak Kaydet"
                          Style="{StaticResource PrimaryActionBtn}"
                          Command="{Binding SaveScannedPagesAsPdfCommand}"
                          Margin="0,0,8,0"/>
                  <Button Content="⚡ DocMaster PDF Studio'ya Aktar"
                          Style="{StaticResource SuccessActionBtn}"
                          Command="{Binding SendScannedToPdfStudioCommand}"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Taranan Sayfalar Grid ve Önizleme -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="280"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Küçük Resim Listesi -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                  <ListBox ItemsSource="{Binding ScannedPages}"
                           SelectedItem="{Binding SelectedScannedPage}"
                           BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type models:ScannedPageItem}">
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4" Background="White">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="60"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Source="{Binding PreviewImage}" MaxHeight="70" Stretch="Uniform"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                              <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13"/>
                              <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="Gray"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="✕"
                                    Foreground="Red" Background="Transparent" BorderThickness="0"
                                    Command="{Binding DataContext.DeleteSelectedScannedPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand" FontWeight="Bold" Padding="6,2"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </ScrollViewer>

                <!-- Büyük Önizleme Paneli -->
                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="12">
                  <Grid>
                    <Image Source="{Binding SelectedScannedPage.PreviewImage}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                      <Button Content="↻ 90° Döndür"
                              Style="{StaticResource SecondaryActionBtn}"
                              Command="{Binding RotateSelectedScannedPageCommand}"
                              Margin="0,0,6,0"/>
                      <Button Content="🗑️ Sayfayı Sil"
                              Style="{StaticResource SecondaryActionBtn}"
                              Command="{Binding DeleteSelectedScannedPageCommand}"
                              CommandParameter="{Binding SelectedScannedPage}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <!-- İlerleme Çubuğu -->
            <ProgressBar Grid.Row="2" Value="{Binding ScanProgress}" Maximum="100" Height="4" Margin="0,8,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ==================== SEKME 3: YAZICI STÜDYOSU ==================== -->
      <TabItem Header="🖨️ Yazıcı Stüdyosu (Ricoh &amp; Spooler)" FontSize="14" FontWeight="SemiBold">
        <Grid Margin="12,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Sol Taraf: Yazdırma Ayarları -->
          <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Yazdırma Ayarları" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                <!-- Yazıcı Seçimi -->
                <TextBlock Text="Hedef Yazıcı:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedPrinter}"
                          DisplayMemberPath="Name"
                          Padding="8,6" Margin="0,0,0,14"/>

                <!-- Yazdırılacak Dosya -->
                <TextBlock Text="Yazdırılacak Belge:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding SelectedPrintFilePath}" IsReadOnly="True" Padding="8,6"/>
                  <Button Grid.Column="1" Content="Seç..." Style="{StaticResource SecondaryActionBtn}"
                          Command="{Binding SelectPrintFileCommand}" Margin="6,0,0,0"/>
                </Grid>

                <!-- Kopya Sayısı -->
                <TextBlock Text="Kopya Sayısı:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox Text="{Binding PrintOptions.Copies, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,14"/>

                <!-- Çift Taraflı (Duplex) -->
                <TextBlock Text="Çift Taraflı Yazdırma (Duplex):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox SelectedValue="{Binding PrintOptions.Duplex}"
                          SelectedValuePath="Tag"
                          Padding="8,6" Margin="0,0,0,14">
                  <ComboBoxItem Content="Tek Taraflı (Simplex)" Tag="{x:Static models:PrintDuplex.Simplex}" IsSelected="True"/>
                  <ComboBoxItem Content="Çift Taraflı - Uzun Kenar (Kitapçık)" Tag="{x:Static models:PrintDuplex.DuplexLongEdge}"/>
                  <ComboBoxItem Content="Çift Taraflı - Kısa Kenar (Takvim)" Tag="{x:Static models:PrintDuplex.DuplexShortEdge}"/>
                </ComboBox>

                <!-- Yönlendirme -->
                <TextBlock Text="Yönlendirme:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox SelectedValue="{Binding PrintOptions.Orientation}"
                          SelectedValuePath="Tag"
                          Padding="8,6" Margin="0,0,0,14">
                  <ComboBoxItem Content="Dikey (Portrait)" Tag="{x:Static models:PrintOrientation.Portrait}" IsSelected="True"/>
                  <ComboBoxItem Content="Yatay (Landscape)" Tag="{x:Static models:PrintOrientation.Landscape}"/>
                </ComboBox>

                <!-- Sayfaya Sığdır -->
                <CheckBox Content="Sayfaya tam sığdır (Fit to Page)"
                          IsChecked="{Binding PrintOptions.FitToPage}"
                          Margin="0,0,0,18"/>

                <!-- Yazdır Butonu -->
                <Button Content="🖨️ Belgeyi Yazdır"
                        Style="{StaticResource PrimaryActionBtn}"
                        Command="{Binding PrintSelectedFileCommand}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,8" Height="42" FontSize="14"/>

                <Button Content="📋 Test Sayfası Yazdır (Ricoh/Windows)"
                        Style="{StaticResource SecondaryActionBtn}"
                        Command="{Binding PrintTestPageCommand}"
                        HorizontalAlignment="Stretch"/>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- Sağ Taraf: Yazıcı Durum Bilgisi & İpuçları -->
          <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
            <StackPanel>
              <TextBlock Text="Yazıcı Durumu ve Ağ Bilgisi" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

              <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Seçili Yazıcı:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPrinter.Name}" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Bağlantı Türü:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPrinter.ConnectionDescription}" Foreground="#0F172A" Margin="0,0,0,6"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Sürücü Durumu:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPrinter.DriverStatusDescription}" Foreground="#16A34A" FontWeight="SemiBold" Margin="0,0,0,6"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Durum Mesajı:" FontWeight="SemiBold" Foreground="#64748B"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPrinter.StatusMessage}" Foreground="#0F172A"/>
                </Grid>
              </Border>

              <TextBlock Text="Ricoh SP 4510SF Özel Bilgileri:" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
              <TextBlock Text="• Ricoh SP 4510SF dakikada 40 sayfa basabilen monokrom kurumsal bir çok fonksiyonlu yazıcıdır."
                         FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,4"/>
              <TextBlock Text="• Ağ üzerinden (TCP/IP Port 9100 RAW) sürücü bağımlılığı olmaksızın anında yüksek hızda baskı alabilir."
                         FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,4"/>
              <TextBlock Text="• Çift taraflı (Duplex) yazdırma standart olarak desteklenmektedir."
                         FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

    </TabControl>
  </Grid>
</UserControl>
