<UserControl x:Class="DocConverter.Views.PdfStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DocConverter.Models"
             UseLayoutRounding="True"
             Focusable="True"
             FocusVisualStyle="{x:Null}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <SolidColorBrush x:Key="StudioInk" Color="#172033"/>
    <SolidColorBrush x:Key="StudioMuted" Color="#637083"/>
    <SolidColorBrush x:Key="StudioLine" Color="#DFE5EE"/>
    <SolidColorBrush x:Key="StudioAccent" Color="#2563EB"/>
    <SolidColorBrush x:Key="StudioCanvas" Color="#525659"/>

    <!-- Araç çubuğu düğmesi: düz, üzerine gelince vurgulanan -->
    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource StudioInk}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#E8EEFB"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#D5E0F8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.38"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryToolbarButton" BasedOn="{StaticResource ToolbarButton}" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="#2563EB" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#1D4ED8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#1E40AF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ToolbarSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Margin" Value="7,0"/>
      <Setter Property="Background" Value="{StaticResource StudioLine}"/>
    </Style>

    <Style x:Key="ToolbarTextBox" TargetType="TextBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#C9D2DE"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="PanelHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource StudioMuted}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </UserControl.Resources>

  <Grid Background="#F3F6FA"
        AllowDrop="True"
        DragEnter="PdfStudio_DragEnter"
        DragOver="PdfStudio_DragOver"
        Drop="PdfStudio_Drop">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ==================== ARAÇ ÇUBUĞU ==================== -->
    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource StudioLine}" BorderThickness="0,0,0,1" Padding="10,7">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Dosya -->
          <Button Style="{StaticResource PrimaryToolbarButton}" Command="{Binding OpenPdfCommand}" ToolTip="PDF aç (Ctrl+O)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" Margin="0,0,7,0"/>
              <TextBlock Text="Aç" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveCommand}" ToolTip="Kaydet (Ctrl+S)" Margin="5,0,1,0">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;"/>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveAsCommand}" ToolTip="Farklı kaydet (Ctrl+Shift+S)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE792;"/>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding PrintCommand}" ToolTip="Yazdır (Ctrl+P)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE749;"/>
          </Button>

          <Border Style="{StaticResource ToolbarSeparator}"/>

          <Button Style="{StaticResource ToolbarButton}" Command="{Binding ToggleThumbnailPaneCommand}" ToolTip="Sayfa küçük resimlerini göster / gizle">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE700;"/>
          </Button>

          <Border Style="{StaticResource ToolbarSeparator}"/>

          <!-- Sayfa gezinme -->
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding PreviousPageCommand}" ToolTip="Önceki sayfa (←)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70E;" FontSize="13"/>
          </Button>
          <TextBox x:Name="PageNumberBox"
                   Style="{StaticResource ToolbarTextBox}"
                   Width="46"
                   Margin="3,0,0,0"
                   HorizontalContentAlignment="Center"
                   Text="{Binding JumpToPageText, UpdateSourceTrigger=PropertyChanged}"
                   KeyDown="PageNumberBox_KeyDown"
                   GotKeyboardFocus="TextBox_SelectAllOnFocus"
                   ToolTip="Sayfa numarası yazıp Enter'a basın"/>
          <TextBlock Text="{Binding PageCountLabel}" VerticalAlignment="Center" Margin="6,0,4,0"
                     Foreground="{StaticResource StudioMuted}" FontSize="13"/>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding NextPageCommand}" ToolTip="Sonraki sayfa (→)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="13"/>
          </Button>

          <Border Style="{StaticResource ToolbarSeparator}"/>

          <!-- Yakınlaştırma -->
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding ZoomOutCommand}" ToolTip="Uzaklaştır (Ctrl+-)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE738;" FontSize="13"/>
          </Button>
          <ComboBox x:Name="ZoomBox"
                    Width="132"
                    Height="30"
                    Margin="2,0"
                    IsEditable="True"
                    IsTextSearchEnabled="False"
                    VerticalContentAlignment="Center"
                    FontSize="13"
                    ItemsSource="{Binding ZoomPresets}"
                    Text="{Binding ZoomText, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                    DropDownClosed="ZoomBox_DropDownClosed"
                    KeyDown="ZoomBox_KeyDown"
                    LostKeyboardFocus="ZoomBox_LostKeyboardFocus"
                    ToolTip="Yakınlaştırma (Ctrl + fare tekerleği)"/>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding ZoomInCommand}" ToolTip="Yakınlaştır (Ctrl++)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="13"/>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding FitWidthCommand}" Content="Genişlik"
                  ToolTip="Genişliğe sığdır (Ctrl+2)" Margin="4,0,1,0"/>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding FitPageCommand}" Content="Sayfa"
                  ToolTip="Sayfaya sığdır (Ctrl+0)"/>
        </StackPanel>

        <!-- Arama -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource ToolbarSeparator}"/>
          <TextBox x:Name="SearchBox"
                   Style="{StaticResource ToolbarTextBox}"
                   Width="170"
                   Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                   KeyDown="SearchBox_KeyDown"
                   GotKeyboardFocus="TextBox_SelectAllOnFocus"
                   ToolTip="Belgede ara (Ctrl+F), Enter ile başlat"/>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding SearchCommand}" ToolTip="Ara (Enter)" Margin="3,0,1,0">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;"/>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding PreviousSearchResultCommand}" ToolTip="Önceki sonuç (Shift+F3)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70E;" FontSize="13"/>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding NextSearchResultCommand}" ToolTip="Sonraki sonuç (F3)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="13"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ==================== İÇERİK ==================== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="236"/>
      </Grid.ColumnDefinitions>

      <!-- Küçük resim paneli -->
      <Border Grid.Column="0"
              Width="168"
              Background="#F7F8FA"
              BorderBrush="{StaticResource StudioLine}"
              BorderThickness="0,0,1,0"
              Visibility="{Binding IsThumbnailPaneVisible, Converter={StaticResource BoolToVis}}">
        <ListBox x:Name="ThumbnailList"
                 ItemsSource="{Binding Pages}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0,6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Standard"
                 VirtualizingPanel.ScrollUnit="Pixel">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <EventSetter Event="Loaded" Handler="ThumbnailItem_Loaded"/>
              <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ThumbnailItem_Click"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="HorizontalContentAlignment" Value="Center"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="0,7,0,5" Margin="6,0" CornerRadius="6">
                      <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="#E9EDF3"/>
                      </Trigger>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="#DCE7FD"/>
                      </DataTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Center">
                <Border x:Name="Frame" Background="White" BorderBrush="#B8C1CE" BorderThickness="1"
                        Width="112" MinHeight="60" MaxHeight="230" HorizontalAlignment="Center">
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock x:Name="Number" Text="{Binding PageNumber}" HorizontalAlignment="Center" Margin="0,4,0,0"
                           FontSize="11" Foreground="{StaticResource StudioMuted}"/>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter TargetName="Frame" Property="BorderBrush" Value="#2563EB"/>
                  <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                  <Setter TargetName="Number" Property="Foreground" Value="#1D4ED8"/>
                  <Setter TargetName="Number" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Belge alanı -->
      <Grid Grid.Column="1" Background="{StaticResource StudioCanvas}" ClipToBounds="True">
        <ListBox x:Name="DocumentPagesList"
                 ItemsSource="{Binding Pages}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="24,14"
                 Focusable="True"
                 FocusVisualStyle="{x:Null}"
                 KeyboardNavigation.TabNavigation="None"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.VirtualizationMode="Standard"
                 VirtualizingPanel.CacheLength="1"
                 VirtualizingPanel.CacheLengthUnit="Page"
                 SizeChanged="DocumentPagesList_SizeChanged"
                 PreviewMouseWheel="DocumentPagesList_PreviewMouseWheel"
                 PreviewMouseDown="DocumentPagesList_PreviewMouseDown"
                 PreviewMouseMove="DocumentPagesList_PreviewMouseMove"
                 PreviewMouseUp="DocumentPagesList_PreviewMouseUp"
                 LostMouseCapture="DocumentPagesList_LostMouseCapture"
                 ScrollViewer.ScrollChanged="DocumentPagesList_ScrollChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <EventSetter Event="Loaded" Handler="PdfStudioPageItem_Loaded"/>
              <EventSetter Event="Unloaded" Handler="PdfStudioPageItem_Unloaded"/>
              <Setter Property="HorizontalContentAlignment" Value="Center"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,0,0,12"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="Center"/>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <!-- Sayfa: beyaz kağıt + ince gölge çizgisi -->
              <Border Background="White" BorderBrush="#26000000" BorderThickness="0,0,1,1" HorizontalAlignment="Center">
                <Grid x:Name="PageSurface"
                      Width="{Binding ViewWidth}"
                      Height="{Binding ViewHeight}"
                      Background="White"
                      MouseLeftButtonDown="PageSurface_MouseLeftButtonDown">
                  <Image x:Name="PageImage"
                         Source="{Binding Image}"
                         Stretch="Fill"
                         SnapsToDevicePixels="True"
                         RenderOptions.BitmapScalingMode="HighQuality"/>

                  <TextBlock x:Name="Placeholder"
                             Text="{Binding RenderStatus}"
                             Foreground="#9AA3B2"
                             FontSize="13"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"/>

                  <!-- Arama sonuçları -->
                  <ItemsControl ItemsSource="{Binding SearchResults}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding ViewX}"/>
                        <Setter Property="Canvas.Top" Value="{Binding ViewY}"/>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border x:Name="Hit"
                                Width="{Binding ViewWidth}"
                                Height="{Binding ViewHeight}"
                                Background="#66FFE000"/>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Hit" Property="Background" Value="#80FF8A00"/>
                            <Setter TargetName="Hit" Property="BorderBrush" Value="#E65100"/>
                            <Setter TargetName="Hit" Property="BorderThickness" Value="1"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Açıklamalar: ekrandaki görünüm, PDF'e yazılan sonuçla aynı olacak şekilde çizilir -->
                  <ItemsControl ItemsSource="{Binding Annotations}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding ViewX}"/>
                        <Setter Property="Canvas.Top" Value="{Binding ViewY}"/>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Width="{Binding ViewWidth}"
                              Height="{Binding ViewHeight}"
                              Background="Transparent"
                              Cursor="Hand"
                              MouseLeftButtonDown="Annotation_MouseLeftButtonDown">
                          <Border x:Name="Fill" Background="{Binding Color}" Opacity="{Binding Opacity}" Visibility="Collapsed"/>
                          <Border x:Name="Outline" BorderBrush="{Binding Color}" BorderThickness="2" Visibility="Collapsed"/>
                          <TextBlock x:Name="Label"
                                     Text="{Binding Text}"
                                     FontFamily="Arial"
                                     FontSize="{Binding ViewFontSize}"
                                     Foreground="{Binding Color}"
                                     TextWrapping="Wrap"
                                     ClipToBounds="True"
                                     Visibility="Collapsed"/>
                          <Rectangle x:Name="Selection"
                                     Stroke="#2563EB"
                                     StrokeThickness="1.5"
                                     StrokeDashArray="3 2"
                                     Margin="-3"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PdfAnnotationType.Text}">
                            <Setter TargetName="Label" Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PdfAnnotationType.Highlight}">
                            <Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PdfAnnotationType.Note}">
                            <Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Fill" Property="CornerRadius" Value="6"/>
                            <Setter TargetName="Fill" Property="BorderBrush" Value="#C69A00"/>
                            <Setter TargetName="Fill" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="Label" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Label" Property="Foreground" Value="Black"/>
                            <Setter TargetName="Label" Property="Margin" Value="8,6"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PdfAnnotationType.Rectangle}">
                            <Setter TargetName="Outline" Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PdfAnnotationType.Ink}">
                            <Setter TargetName="Outline" Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Selection" Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                  <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- Bitmap ekran pikselleriyle birebir eşleşiyorsa yeniden örnekleme yapılmaz: metin keskin kalır -->
                <DataTrigger Binding="{Binding IsImageExact}" Value="True">
                  <Setter TargetName="PageImage" Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Boş durum -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasSession}" Value="False">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" FontSize="44" Foreground="#C5CAD3" HorizontalAlignment="Center"/>
          <TextBlock Text="PDF açmak için dosyayı buraya sürükleyin" Foreground="#E3E6EB" FontSize="16"
                     FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
          <TextBlock Text="ya da araç çubuğundaki Aç düğmesini kullanın (Ctrl+O)" Foreground="#B6BCC7" FontSize="13"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>

      <!-- Araçlar paneli -->
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource StudioLine}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,14,14,16">
            <TextBlock Text="ARAÇLAR" Style="{StaticResource PanelHeader}"/>
            <ListBox SelectedValue="{Binding SelectedTool}"
                     SelectedValuePath="Tag"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Cursor" Value="Hand"/>
                  <Setter Property="FontSize" Value="13"/>
                  <Setter Property="Foreground" Value="{StaticResource StudioInk}"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="10,7" Margin="0,1">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#F0F3F8"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#DCE7FD"/>
                            <Setter Property="Foreground" Value="#1D4ED8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBoxItem Tag="{x:Static models:PdfStudioTool.Select}" Content="Seç / Kaydır"
                           ToolTip="Sayfayı sürükleyerek kaydırın, açıklamaya tıklayarak seçin"/>
              <ListBoxItem Tag="{x:Static models:PdfStudioTool.Text}" Content="Metin ekle"/>
              <ListBoxItem Tag="{x:Static models:PdfStudioTool.Highlight}" Content="Vurgula"/>
              <ListBoxItem Tag="{x:Static models:PdfStudioTool.Note}" Content="Not ekle"/>
              <ListBoxItem Tag="{x:Static models:PdfStudioTool.Rectangle}" Content="Kutu çiz"/>
              <ListBoxItem Tag="{x:Static models:PdfStudioTool.Eraser}" Content="Silgi"/>
            </ListBox>

            <Border Height="1" Background="{StaticResource StudioLine}" Margin="0,14"/>

            <TextBlock Text="ÖZELLİKLER" Style="{StaticResource PanelHeader}"/>
            <TextBlock Text="Metin" Foreground="{StaticResource StudioMuted}" FontSize="12"/>
            <TextBox Text="{Binding AnnotationText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" MinHeight="30"
                     Padding="6,4" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#C9D2DE"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Renk (#RRGGBB)" Foreground="{StaticResource StudioMuted}" FontSize="12"/>
                <TextBox Text="{Binding AnnotationColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="30"
                         Padding="6,0" VerticalContentAlignment="Center" BorderBrush="#C9D2DE"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Yazı boyutu (pt)" Foreground="{StaticResource StudioMuted}" FontSize="12"/>
                <TextBox Text="{Binding AnnotationFontSize, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" Height="30"
                         Padding="6,0" VerticalContentAlignment="Center" BorderBrush="#C9D2DE"/>
              </StackPanel>
            </Grid>
            <Button Content="Seçilene uygula" Style="{StaticResource PrimaryToolbarButton}" HorizontalAlignment="Stretch"
                    Margin="0,0,0,6" Command="{Binding ApplyAnnotationPropertiesCommand}"/>
            <Button Content="Seçileni sil" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Stretch"
                    Command="{Binding DeleteSelectedAnnotationCommand}" Foreground="#B91C1C"/>

            <Border Height="1" Background="{StaticResource StudioLine}" Margin="0,14"/>

            <TextBlock Text="ARAMA SONUÇLARI" Style="{StaticResource PanelHeader}"/>
            <ListBox ItemsSource="{Binding SearchResults}"
                     SelectedItem="{Binding SelectedSearchResult}"
                     MinHeight="90"
                     MaxHeight="260"
                     BorderBrush="#D7DEE8"
                     BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" Margin="2,3" FontSize="12"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ==================== DURUM ÇUBUĞU ==================== -->
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource StudioLine}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="2"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ProgressBar Grid.Row="0" IsIndeterminate="{Binding IsBusy}" BorderThickness="0" Background="Transparent"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        <Grid Grid.Row="1" Margin="12,4,12,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding CurrentFileName}" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource StudioInk}" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="1" Text="{Binding PageSizeLabel}" FontSize="12" Foreground="{StaticResource StudioMuted}"
                     Margin="14,0,0,0"/>
          <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource StudioMuted}"
                     Margin="14,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="3" Text="{Binding DirtyLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#B45309"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
