<UserControl x:Class="DocConverter.Views.HomeHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DocConverter.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

  <UserControl.Resources>
    <!-- Hub Card Button Style -->
    <Style x:Key="HubCardButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CardBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="16"
                    Padding="28,24">
              <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.06" BlurRadius="20" ShadowDepth="4"/>
              </Border.Effect>
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3B82F6"/>
                <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC"/>
                <Setter Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#2563EB" Opacity="0.16" BlurRadius="24" ShadowDepth="6"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuickActionButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="Foreground" Value="#1E293B"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BtnBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BtnBorder" Property="Background" Value="#E2E8F0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,24,32,32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Üst Karşılama Başlığı -->
      <StackPanel Grid.Row="0" Margin="0,0,0,24">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
            <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="DocMaster Pro" FontSize="28" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
          <Border Background="#E0E7FF" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="ENTERPRISE HUB" FontSize="11" FontWeight="Bold" Foreground="#3730A3"/>
          </Border>
        </StackPanel>
        <TextBlock Text="Lütfen yapmak istediğiniz çalışma alanını seçin veya hızlı eylemlerle anında başlayın."
                   FontSize="15" Foreground="#64748B" Margin="0,6,0,0"/>
      </StackPanel>

      <!-- 3 Ana Seçenek Kartı -->
      <Grid Grid.Row="1" Margin="0,0,0,28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- KART 1: Office ve Belge İşlemleri -->
        <Button Grid.Column="0"
                Style="{StaticResource HubCardButtonStyle}"
                Command="{Binding OpenOfficeSuiteCommand}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#EFF6FF" CornerRadius="12" Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,14">
              <TextBlock Text="📁" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Row="1" Text="Office &amp; Belge İşlemleri" FontSize="19" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="2" Text="Word, Excel, PowerPoint, PDF birleştirme, bölme ve dönüştürme stüdyosu."
                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,14"/>

            <!-- Özellik Maddeleri -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="✓" Foreground="#2563EB" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBlock Text="Word, Excel, PPT → PDF dönüştürme" FontSize="12" Foreground="#475569"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="✓" Foreground="#2563EB" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBlock Text="PDF → Düzenlenebilir Word (DOCX)" FontSize="12" Foreground="#475569"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="✓" Foreground="#2563EB" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBlock Text="PDF Birleştirme, Bölme ve Düzenleme" FontSize="12" Foreground="#475569"/>
              </StackPanel>
            </StackPanel>

            <Border Grid.Row="4" Background="#2563EB" CornerRadius="8" Padding="14,8" HorizontalAlignment="Left">
              <TextBlock Text="Office Modülüne Git →" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
            </Border>
          </Grid>
        </Button>

        <!-- KART 2: PDF Studio -->
        <Button Grid.Column="2"
                Style="{StaticResource HubCardButtonStyle}"
                Command="{Binding OpenPdfStudioCommand}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FEF3C7" CornerRadius="12" Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,14">
              <TextBlock Text="⚡" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Row="1" Text="PDF Studio" FontSize="19" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="2" Text="Gelişmiş PDF görüntüleme, sayfa yönetimi, çizim araçları ve metin arama."
                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,14"/>

            <!-- Özellik Maddeleri -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="✓" Foreground="#D97706" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBlock Text="Canlı PDF sayfa önizleme ve yakınlaştırma" FontSize="12" Foreground="#475569"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="✓" Foreground="#D97706" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBlock Text="Vurgulama, metin kutusu ve not ekleme" FontSize="12" Foreground="#475569"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="✓" Foreground="#D97706" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBlock Text="PDF içi metin arama ve doğrudan yazdırma" FontSize="12" Foreground="#475569"/>
              </StackPanel>
            </StackPanel>

            <Border Grid.Row="4" Background="#D97706" CornerRadius="8" Padding="14,8" HorizontalAlignment="Left">
              <TextBlock Text="PDF Studio'yu Aç →" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
            </Border>
          </Grid>
        </Button>

        <!-- KART 3: Yazıcılar ve Tarayıcılar -->
        <Button Grid.Column="4"
                Style="{StaticResource HubCardButtonStyle}"
                Command="{Binding OpenDeviceHubCommand}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F0FDF4" CornerRadius="12" Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,14">
              <TextBlock Text="🖨️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="Yazıcılar &amp; Tarayıcılar" FontSize="19" FontWeight="Bold" Foreground="#1E293B"/>
              <Border Background="#DCFCE7" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="OTOMATİK SÜRÜCÜ" FontSize="9" FontWeight="Bold" Foreground="#15803D"/>
              </Border>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Bilgisayara bağlı ve ağdaki tüm aygıtları otomatik bulur, sürücüleri hazır hale getirir."
                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,14"/>

            <!-- Donanım Özel Maddeleri -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBlock Text="Fujitsu fi-6230 ADF çift taraflı hızlı tarama" FontSize="12" Foreground="#475569"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBlock Text="Ricoh SP 4510SF Ağ / USB doğrudan yazdırma" FontSize="12" Foreground="#475569"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBlock Text="Tek tıkla kurulum ve hazır bağlantı" FontSize="12" Foreground="#475569"/>
              </StackPanel>
            </StackPanel>

            <Border Grid.Row="4" Background="#16A34A" CornerRadius="8" Padding="14,8" HorizontalAlignment="Left">
              <TextBlock Text="Aygıt Merkezine Git →" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
            </Border>
          </Grid>
        </Button>
      </Grid>

      <!-- Hızlı Eylemler Çubuğu -->
      <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
            <TextBlock Text="Hızlı Başlat" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Tek tıkla doğrudan ilgili araca geçin" FontSize="12" Foreground="#64748B"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Content="📊 Office → PDF" Style="{StaticResource QuickActionButtonStyle}"
                    Command="{Binding OpenOfficeSuiteCommand}"/>
            <Button Content="⚡ PDF Studio" Style="{StaticResource QuickActionButtonStyle}"
                    Command="{Binding OpenPdfStudioCommand}"/>
            <Button Content="📑 Fujitsu ile Tara" Style="{StaticResource QuickActionButtonStyle}"
                    Command="{Binding OpenScannerStudioCommand}"/>
            <Button Content="🖨️ Ricoh ile Yazdır" Style="{StaticResource QuickActionButtonStyle}"
                    Command="{Binding OpenPrinterStudioCommand}"/>
          </StackPanel>
        </Grid>
      </Border>

    </Grid>
  </ScrollViewer>
</UserControl>
